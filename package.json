{
  "name": "@enwindui/monorepo",
  "private": "true",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @enwindui/svelte",
    "build": "npm run build -w @enwindui/svelte",
    "check": "npm run check -w @enwindui/svelte",
    "test": "npm run test -w @enwindui/svelte -- --run",
    "publish:enwind": "npm publish -w @enwindui/enwind --access public",
    "publish:svelte": "npm publish -w @enwindui/svelte --access public"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
